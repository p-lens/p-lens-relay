# Copy to .env (ignored by git) and fill in.

# The relay's host, whose DNS points at this server; Caddy gets its certificate.
RELAY_HOST=relay.example.com

# open: your own relay, taking anything PLN-1 shapes. capped: a relay others
# use, every line held to fixed caps. gated: taking payment, with the issuer.
ENTITLEMENT=open

# What NIP-11 says of the relay.
RELAY_NAME=P-Lens relay
RELAY_DESCRIPTION=

# For ENTITLEMENT=gated: the issuer's https:// address — this relay's own
# host, where the issuer is started beside it — and its public key (from
# bun --cwd=packages/tickets run make-key).
ISSUER_URL=
ISSUER_PUBLIC_KEY=

# For the issuer (--profile issuer): its private key, and the operator's
# token for making plans, 32 characters or more.
ISSUER_PRIVATE_KEY=
ADMIN_TOKEN=
